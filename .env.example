# Equipo 3 - Inventario y Notificaciones
# Copia este archivo como .env antes de ejecutar:  Copy-Item .env.example .env
# El docker-compose exige MYSQL_ROOT_PASSWORD y MYSQL_PASSWORD: sin .env no arranca.

# ---------------------------------------------------------------------------
# 1) PUERTOS PUBLICADOS en esta computadora (lado izquierdo de "publicado:interno").
#    El acuerdo entre los tres equipos es 2506 (inventario) y 2507 (notificaciones).
#    MySQL NO se publica: solo se usa dentro de la red de Docker.
# ---------------------------------------------------------------------------
INVENTARIO_HOST_PORT=2506
NOTIFICACIONES_HOST_PORT=2507

# ---------------------------------------------------------------------------
# 2) Credenciales de MySQL. CAMBIA las dos contraseñas antes de la demostración.
#    MYSQL_USER y MYSQL_DATABASE ya coinciden con database/init.sql.
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=cambia_esta_contrasena_root
MYSQL_DATABASE=team3_inventory
MYSQL_USER=team3_app
MYSQL_PASSWORD=cambia_esta_contrasena_app

# ---------------------------------------------------------------------------
# 3) Referencia para los otros equipos (no se configura aquí, ellos escriben la
#    IP de esta computadora en SU .env):
#    INVENTARIO_URL=http://IP-EQUIPO-3:2506
#    NOTIFICACIONES_URL=http://IP-EQUIPO-3:2507
# ---------------------------------------------------------------------------
