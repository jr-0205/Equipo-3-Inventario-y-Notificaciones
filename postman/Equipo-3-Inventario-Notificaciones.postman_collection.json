{
  "info": {
    "_postman_id": "c3d4e5f6-3333-4c4d-9e5f-equipo3inventarionoti",
    "name": "Equipo 3 - Inventario y Notificaciones",
    "description": "Colección para probar Inventario (2506) y Notificaciones (2507) con los puertos publicados por Docker Compose.\n\nCambia la variable {{host}} por la IPv4 de la computadora del Equipo 3 (o deja 'localhost' si Postman corre en esa misma máquina).\n\nInventario es dueño SOLO de las existencias: el producto debe existir antes en el catálogo del Equipo 1 (PRODUCTOS_URL, puerto 2502) y se identifica con el MISMO id del catálogo. Las rutas canónicas son /inventario y /notificaciones; /api/products y /api/notifications se conservan como alias compatibles.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "host",
      "value": "localhost"
    },
    {
      "key": "productoId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Salud",
      "item": [
        {
          "name": "Health inventario (incluye estado del catalogo)",
          "request": {
            "method": "GET",
            "url": "http://{{host}}:2506/health"
          }
        },
        {
          "name": "Health notificaciones",
          "request": {
            "method": "GET",
            "url": "http://{{host}}:2507/health"
          }
        }
      ]
    },
    {
      "name": "Inventario (rutas canonicas)",
      "item": [
        {
          "name": "Listar catalogo con existencias",
          "request": {
            "method": "GET",
            "url": "http://{{host}}:2506/inventario"
          }
        },
        {
          "name": "Consultar existencia",
          "request": {
            "method": "GET",
            "url": "http://{{host}}:2506/inventario/{{productoId}}"
          }
        },
        {
          "name": "Registrar existencias",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productoId\": 1,\n  \"stock\": 10,\n  \"descripcion\": \"Estante A\"\n}"
            },
            "url": "http://{{host}}:2506/inventario"
          }
        },
        {
          "name": "Actualizar existencia (solo stock)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock\": 7\n}"
            },
            "url": "http://{{host}}:2506/inventario/{{productoId}}"
          }
        },
        {
          "name": "Eliminar registro de existencias",
          "request": {
            "method": "DELETE",
            "url": "http://{{host}}:2506/inventario/{{productoId}}"
          }
        }
      ]
    },
    {
      "name": "Inventario (alias /api/products)",
      "item": [
        {
          "name": "Listar por alias",
          "request": {
            "method": "GET",
            "url": "http://{{host}}:2506/api/products"
          }
        },
        {
          "name": "Consultar por alias",
          "request": {
            "method": "GET",
            "url": "http://{{host}}:2506/api/products/{{productoId}}"
          }
        },
        {
          "name": "Registrar existencias por alias",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productoId\": 1,\n  \"stock\": 5\n}"
            },
            "url": "http://{{host}}:2506/api/products"
          }
        }
      ]
    },
    {
      "name": "Notificaciones (rutas canonicas)",
      "item": [
        {
          "name": "Listar notificaciones",
          "request": {
            "method": "GET",
            "url": "http://{{host}}:2507/notificaciones?limite=30"
          }
        },
        {
          "name": "Registrar notificacion",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"servicio\": \"pedidos\",\n  \"mensaje\": \"Compra procesada\",\n  \"tipo\": \"success\"\n}"
            },
            "url": "http://{{host}}:2507/notificaciones"
          }
        },
        {
          "name": "Eliminar notificacion",
          "request": {
            "method": "DELETE",
            "url": "http://{{host}}:2507/notificaciones/1"
          }
        }
      ]
    },
    {
      "name": "Notificaciones (alias /api/notifications)",
      "item": [
        {
          "name": "Listar por alias",
          "request": {
            "method": "GET",
            "url": "http://{{host}}:2507/api/notifications?limit=30"
          }
        }
      ]
    }
  ]
}
