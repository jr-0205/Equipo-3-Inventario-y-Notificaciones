# Configuración local del Equipo 3. Lo normal es generarlo con:
#     node configurar-ips.mjs        (lee las direcciones de `ip-path`)
#
# Este archivo es la plantilla común de los tres equipos: declara los hosts y los
# puertos de los seis microservicios y del frontend. Si no tienes DNS local, escribe
# la IPv4 actual de cada laptop en los valores de host/URLs.
#
# El docker-compose exige MYSQL_ROOT_PASSWORD y MYSQL_PASSWORD: sin .env no arranca.
# Cambia las dos contraseñas antes de la demostración.
EQUIPO1_HOST=equipo1.local
EQUIPO2_HOST=equipo2.local
EQUIPO3_HOST=equipo3.local
FRONTEND_HOST=frontend.local

CLIENTES_URL=http://${EQUIPO1_HOST}:2501
# Inventario usa esta URL para leer el catálogo oficial (IDs, nombres y precios).
PRODUCTOS_URL=http://${EQUIPO1_HOST}:2502
PEDIDOS_URL=http://${EQUIPO2_HOST}:2503
PAGOS_URL=http://${EQUIPO2_HOST}:2504
INVENTARIO_URL=http://${EQUIPO3_HOST}:2506
NOTIFICACIONES_URL=http://${EQUIPO3_HOST}:2507
FRONTEND_URL=http://${FRONTEND_HOST}:2222

CLIENTES_PORT=2501
PRODUCTOS_PORT=2502
PEDIDOS_PORT=2503
PAGOS_PORT=2504
INVENTARIO_PORT=2506
NOTIFICACIONES_PORT=2507
FRONTEND_PORT=2222

MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=team3_inventory
MYSQL_USER=team3_app
MYSQL_PASSWORD=change_this_app_password
REQUEST_TIMEOUT_MS=10000
