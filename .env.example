MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=team3_inventory
MYSQL_USER=team3_app
MYSQL_PASSWORD=change_this_app_password

# Sustituye IP_EQUIPO_1 por la IP real del equipo que ejecuta Productos.
# Configura este valor en el .env local; no publiques IP privadas de la LAN.
PRODUCTOS_URL=http://IP_EQUIPO_1:2502
